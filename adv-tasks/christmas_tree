#include<stdio.h>
int main() {
    int n, i, j;
    printf("Enter the height of the Christmas tree: ");
    scanf("%d", &n);


    for(i = 1; i <= n; i++) {

        for(j = i; j < n; j++) {
            printf(" ");
        }

        for(j = 1; j <= (2 * i - 1); j++) {
            printf("*");
        }
        printf("\n");
    }

 
    for(i = 1; i <= n / 3; i++) {
        for(j = 1; j < n; j++) {
            printf(" ");
        }
        printf("*\n");
    }

    return 0;
}